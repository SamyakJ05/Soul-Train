SPOTIPY_CLIENT_ID=your-client-id
SPOTIPY_CLIENT_SECRET=your-client-secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:5001/callback
FLASK_SECRET_KEY=replace-with-a-random-value
# Use 1 in production. HTTPS Spotify redirect URIs enable this automatically.
SESSION_COOKIE_SECURE=0
ADMIN_PASSWORD_HASH=
# Local fallback only. Prefer ADMIN_PASSWORD_HASH for deployments.
ADMIN_PASSWORD=
# Set this to a persistent disk path when your host provides one.
SOUL_TRAIN_DATABASE_PATH=instance/playlist_drafts.sqlite3
